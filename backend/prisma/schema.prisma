generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Click {
  id          String        @id @default(uuid()) @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")
  referrer    String?       @db.Text
  userAgent   String?       @map("user_agent") @db.Text
  ip          String?       @db.VarChar(64)
  queryParams Json          @map("query_params")
  attribution Attribution[]

  @@index([createdAt])
  @@map("clicks")
}

model Attribution {
  id                        String                     @id @default(uuid()) @db.Uuid
  clickUuid                 String?                    @map("click_id") @db.Uuid
  telegramUserId            BigInt                     @map("telegram_user_id")
  createdAt                 DateTime                   @default(now()) @map("created_at")
  click                     Click?                     @relation(fields: [clickUuid], references: [id], onDelete: Restrict)
  depositConversions        DepositConversion[]

  @@unique([telegramUserId])
  @@index([telegramUserId, createdAt])
  @@map("attributions")
}

model DepositConversion {
  id             String      @id @default(uuid()) @db.Uuid
  attributionId  String      @map("attribution_id") @db.Uuid
  telegramUserId BigInt     @map("telegram_user_id")
  amountUsd      Decimal    @map("amount_usd") @db.Decimal(14, 2)
  createdAt      DateTime   @default(now()) @map("created_at")
  attribution    Attribution @relation(fields: [attributionId], references: [id], onDelete: Restrict)

  @@index([attributionId, createdAt])
  @@index([telegramUserId, createdAt])
  @@map("deposit_conversions")
}

model RedirectRule {
  id          String   @id @default(uuid()) @db.Uuid
  referrer    String?  @unique @db.Text
  redirectUrl String   @map("redirect_url") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@map("redirect_rules")
}

enum AdAccountPlatform {
  facebook
  tiktok
}

model AdAccount {
  id        String            @id @default(uuid()) @db.Uuid
  platform  AdAccountPlatform
  name      String            @db.Text
  pixelId   String            @map("pixel_id") @db.Text
  accessKey String            @map("access_key") @db.Text
  createdAt DateTime          @default(now()) @map("created_at")

  @@index([platform, createdAt])
  @@map("ad_accounts")
}

model TelegramTrackedAccount {
  id              String                 @id @default(uuid()) @db.Uuid
  label           String                 @db.Text
  apiId           Int                    @map("api_id")
  apiHash         String                 @map("api_hash") @db.Text
  sessionString   String                 @map("session_string") @db.Text
  isActive        Boolean                @default(true) @map("is_active")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  incomingMessages IncomingMessage[]

  @@index([isActive, createdAt])
  @@map("telegram_tracked_accounts")
}

model IncomingMessage {
  id                  String                 @id @default(uuid()) @db.Uuid
  trackedAccountId    String                 @map("tracked_account_id") @db.Uuid
  fromTelegramUserId  BigInt                 @map("from_telegram_user_id")
  chatTelegramId      BigInt?                @map("chat_telegram_id")
  telegramMessageId   Int?                   @map("telegram_message_id")
  messageText         String?                @map("message_text") @db.Text
  fromFirstName       String?                @map("from_first_name") @db.Text
  fromLastName        String?                @map("from_last_name") @db.Text
  receivedAt          DateTime               @map("received_at")
  createdAt           DateTime               @default(now()) @map("created_at")
  trackedAccount      TelegramTrackedAccount @relation(fields: [trackedAccountId], references: [id], onDelete: Cascade)

  @@index([trackedAccountId, receivedAt])
  @@index([trackedAccountId, chatTelegramId, receivedAt])
  @@index([trackedAccountId, fromTelegramUserId, receivedAt])
  @@map("incoming_messages")
}
